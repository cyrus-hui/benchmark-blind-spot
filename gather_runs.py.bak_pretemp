import json, glob, os
import numpy as np
from scipy import stats
from collections import defaultdict

import sys
# (run_dir, seeds, has_arc, has_mmlu)
# ARC: recovered for pilot_gpt2m by job 521971, for gpt2m_greedy by job 523414.
# MMLU: GPT-2-family is at floor and cannot move -- deliberately never run.
CONFIGS = {
    "smollm2":  ("smollm2_1.7b", [43,44,45,46,47], True,  True),
    "gpt2":     ("pilot_gpt2m",  [43,44,45,46],    True,  False),
    "greedy":   ("gpt2m_greedy", [43,44,45],       True,  False),
    "nucleus":  ("gpt2m_nucleus",[43,44,45],       False, False),
}
_name = sys.argv[1] if len(sys.argv) > 1 else "smollm2"
if _name not in CONFIGS:
    sys.exit(f"usage: python gather_runs.py {{{'|'.join(CONFIGS)}}}   (got {_name!r})")
_dir, SEEDS, HAS_ARC, HAS_MMLU = CONFIGS[_name]
ROOT = os.path.expandvars(f"$SCRATCH/collapse/{_dir}")
MAXGEN = int(__import__("os").environ.get("MAXGEN", "7"))
GENS = range(0, MAXGEN + 1)
print(f"[gather_runs] {_name} ({_dir})  seeds={SEEDS}  gens 0-{MAXGEN}")

METRIC_KEYS = ["perplexity", "distinct2", "emb_variance", "kl_unigram", "mauve"]
BENCH_TASKS = {
    "hellaswag": "acc_norm,none",
    "lambada_openai": "acc,none",
    "arc_easy": "acc_norm,none",
}
if not HAS_ARC:
    BENCH_TASKS.pop("arc_easy", None)
LAMBADA_PPL_KEY = "perplexity,none"
MMLU_ROLLUPS = {"mmlu", "mmlu_stem", "mmlu_other", "mmlu_social_sciences", "mmlu_humanities"}

# Direction: +1 means RISING = collapse; -1 means FALLING = collapse
DIRECTION = {
    "perplexity": +1, "kl_unigram": +1,
    "distinct2": -1, "mauve": -1, "emb_variance": -1,
    "hellaswag": -1, "lambada_openai": -1, "arc_easy": -1, "mmlu": -1,
    "lambada_ppl": +1,
}

def load_metrics(seed, gen):
    p = os.path.join(ROOT, f"seed{seed}", f"gen{gen}", "metrics.json")
    if not os.path.exists(p): return None
    with open(p) as f: return json.load(f)

def load_benchmarks(seed, gen):
    gdir = os.path.join(ROOT, f"seed{seed}", f"gen{gen}")
    out = {}
    fps = []
    for bdir in sorted([d for d in glob.glob(f"{gdir}/benchmarks*") if not d.endswith("_logsamples")]):
        fps += glob.glob(f"{bdir}/**/results_*.json", recursive=True)
    for fp in fps:
        with open(fp) as f: data = json.load(f)
        res = data.get("results", {})
        for task, val in res.items():
            for tname, mkey in BENCH_TASKS.items():
                if task == tname and mkey in val: out[tname] = val[mkey]
            if task == "lambada_openai" and LAMBADA_PPL_KEY in val:
                out["lambada_ppl"] = val[LAMBADA_PPL_KEY]
        # MMLU: example-weighted mean over 57 leaf subtasks (group row has no aggregate in 0.4.12)
        acc_sum, n_sum = 0.0, 0
        for task, val in res.items():
            if task.startswith("mmlu_") and task not in MMLU_ROLLUPS and "acc,none" in val:
                n = val.get("sample_len", 1)
                acc_sum += val["acc,none"] * n; n_sum += n
        if n_sum: out["mmlu"] = acc_sum / n_sum
    return out

data = defaultdict(lambda: defaultdict(dict))
missing = []
for seed in SEEDS:
    for gen in GENS:
        m = load_metrics(seed, gen)
        if m is None: missing.append(f"seed{seed}/gen{gen}/metrics.json")
        else:
            for k in METRIC_KEYS:
                if k in m: data[k][gen][seed] = m[k]
        b = load_benchmarks(seed, gen)
        if not b: missing.append(f"seed{seed}/gen{gen}/benchmarks")
        for k, v in b.items(): data[k][gen][seed] = v

_DROP = ([] if HAS_ARC else ["arc_easy"]) + ([] if HAS_MMLU else ["mmlu"])
ALL = METRIC_KEYS + [k for k in ["hellaswag","lambada_openai","arc_easy","mmlu","lambada_ppl"] if k not in _DROP]

print("\n=== CROSS-SEED MEANS ===\n")
hdr = "gen | " + " | ".join(f"{m:>14}" for m in ALL)
print(hdr); print("-"*len(hdr))
for gen in GENS:
    row = [f"{gen:>3}"]
    for m in ALL:
        vals = list(data[m][gen].values())
        row.append(f"{np.mean(vals):>10.4f}[{len(vals)}]" if vals else f"{'--':>14}")
    print(" | ".join(row))

# ---- Significance: one-tailed paired t-test vs gen-0, per gen, in collapse direction ----
def first_signal(metric, alpha=0.05):
    base = data[metric][0]
    seeds = sorted(base.keys())
    b = np.array([base[s] for s in seeds])
    d = DIRECTION[metric]
    for gen in range(1, MAXGEN + 1):
        cur = data[metric][gen]
        if not all(s in cur for s in seeds): continue
        c = np.array([cur[s] for s in seeds])
        diff = (c - b) * d            # positive = collapse direction
        if np.allclose(diff, 0): continue
        t, p_two = stats.ttest_rel(c, b)
        # one-tailed in collapse direction
        p_one = p_two/2 if (np.mean(diff) > 0) else 1 - p_two/2
        if p_one < alpha and np.mean(diff) > 0:
            eff = (np.mean(c) - np.mean(b)) / np.mean(b) * 100
            return gen, p_one, eff
    return None, None, None

print(f"\n=== FIRST-SIGNAL (one-tailed paired t-test vs gen0, n={len(SEEDS)}, p<0.05) ===\n")
print(f"{'metric':>16} | {'fam':>14} | {'1st sig':>7} | {'p':>8} | {'eff@sig%':>9} | {'totalΔ%':>8}")
print("-"*78)
FAM = {"perplexity":"Perplexity","kl_unigram":"Distributional","mauve":"Distrib(embed)",
       "distinct2":"Diversity-surf","emb_variance":"Diversity-sem",
       "hellaswag":"Benchmark","lambada_openai":"Benchmark","arc_easy":"Benchmark",
       "mmlu":"Benchmark","lambada_ppl":"Benchmark"}
fs = {}
for m in ALL:
    g, p, eff = first_signal(m)
    fs[m] = g
    v0, v7 = np.mean(list(data[m][0].values())), np.mean(list(data[m][MAXGEN].values()))
    tot = (v7-v0)/v0*100
    gtxt = f"gen {g}" if g else "never"
    ptxt = f"{p:.4f}" if p else "  --  "
    etxt = f"{eff:+.2f}" if eff is not None else "  --  "
    print(f"{m:>16} | {FAM[m]:>14} | {gtxt:>7} | {ptxt:>8} | {etxt:>9} | {tot:>+7.1f}")

# ---- Pairwise lag matrix (signalled metrics only) ----
sig = [m for m in ALL if fs[m] is not None]
print("\n=== PAIRWISE LAG (row first-sig − col first-sig; + = row lags) ===\n")
print("metric".rjust(16) + " | " + " | ".join(f"{m[:10]:>10}" for m in sig))
for r in sig:
    cells = [f"{fs[r]-fs[c]:>+10d}" for c in sig]
    print(f"{r:>16} | " + " | ".join(cells))

# ---- Abruptness: max single-gen |Δ| / total |Δ| ----
print("\n=== ABRUPTNESS (max per-gen |Δ| / |total Δ|; >100% = non-monotonic) ===\n")
print(f"{'metric':>16} | {'maxΔ':>9} | {'totalΔ':>9} | {'abrupt%':>8} | {'at gen':>6}")
print("-"*58)
for m in ALL:
    means = [np.mean(list(data[m][g].values())) for g in GENS]
    deltas = [means[g]-means[g-1] for g in range(1,8)]
    maxd = max(deltas, key=abs); total = means[-1]-means[0]
    ab = abs(maxd)/abs(total)*100 if total != 0 else float('inf')
    atg = deltas.index(maxd)+1
    print(f"{m:>16} | {maxd:>+9.4f} | {total:>+9.4f} | {ab:>7.1f} | {atg:>6}")

if missing:
    print("\n=== MISSING ==="); [print(" ",x) for x in missing]
else:
    print("\n=== All files present ===")
