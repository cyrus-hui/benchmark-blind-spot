#!/usr/bin/env python3
"""
check_benchmark_sig.py  —  per-seed significance test for the rising benchmarks.

Question: are HellaSwag / LAMBADA-acc / ARC-Easy / MMLU gen-0->gen-g rises
statistically distinguishable from noise, or are they flat?

Mirrors the lag-table method: paired t-test across seeds vs the gen-0 baseline,
per generation. Two-tailed (we do NOT assume a direction for the rises — that is
the whole point; a "rise" that isn't significant is just noise). Read-only.

Usage:
    python check_benchmark_sig.py smollm2
    python check_benchmark_sig.py gpt2
    python check_benchmark_sig.py smollm2 --verbose   # dump per-seed values + MMLU sanity check
"""
# Known-good gen-0 anchors for the data-extraction sanity check in --verbose.
# If the reconstructed gen-0 value drifts from these, the extraction is wrong
# and the p-values below it are meaningless.
GEN0_ANCHORS = {
    "smollm2": {"mmlu": 0.4976, "hellaswag": 0.7157,
                "lambada_acc": 0.6775, "arc_easy": 0.7138},
    "gpt2":    {"hellaswag": 0.3934, "lambada_acc": 0.4355},
}
import sys, os, glob, json
import numpy as np
from scipy import stats

SCRATCH = os.environ.get("SCRATCH", os.path.expanduser("~/scratch"))

MODELS = {
    "smollm2": {
        "root": f"{SCRATCH}/collapse/smollm2_1.7b",
        "seeds": [43, 44, 45, 46, 47],
        "gens": list(range(8)),
        # task -> (lm-eval task key, metric key)
        "benchmarks": {
            "hellaswag":   ("hellaswag",      "acc_norm,none"),
            "lambada_acc": ("lambada_openai", "acc,none"),
            "arc_easy":    ("arc_easy",       "acc_norm,none"),
            "mmlu":        ("mmlu",           "MMLU_EXAMPLE_WEIGHTED"),  # special-cased
        },
    },
    "gpt2": {
        "root": f"{SCRATCH}/collapse/pilot_gpt2m",
        "seeds": [43, 44, 45, 46],
        "gens": list(range(8)),
        "benchmarks": {
            "hellaswag":   ("hellaswag",      "acc_norm,none"),
            "lambada_acc": ("lambada_openai", "acc,none"),
        },
    },
}

# MMLU leaf aggregation (matches gather script: example-weighted mean over 57
# leaf subtasks, excluding the bare `mmlu` group and the 4 category rollups).
MMLU_ROLLUPS = {"mmlu", "mmlu_stem", "mmlu_other",
                "mmlu_social_sciences", "mmlu_humanities"}


def find_results_jsons(bench_dir):
    """All results_*.json under a benchmark dir (timestamped subdirs)."""
    return glob.glob(f"{bench_dir}/**/results_*.json", recursive=True)


def load_results_blob(gen_dir):
    """Merge every results_*.json under benchmarks/ into one {task: {metrics}}."""
    merged = {}
    for path in find_results_jsons(f"{gen_dir}/benchmarks"):
        try:
            with open(path) as f:
                blob = json.load(f)
        except Exception:
            continue
        merged.update(blob.get("results", {}))
    return merged


def mmlu_example_weighted(results):
    num, den = 0.0, 0.0
    for task, row in results.items():
        if not task.startswith("mmlu"):
            continue
        if task in MMLU_ROLLUPS:
            continue
        acc = row.get("acc,none")
        n = row.get("sample_len") or row.get("samples")  # lm-eval key drift guard
        if acc is None or not n:
            continue
        num += acc * n
        den += n
    return (num / den) if den else None


def get_metric(results, task_key, metric_key):
    if metric_key == "MMLU_EXAMPLE_WEIGHTED":
        return mmlu_example_weighted(results)
    row = results.get(task_key)
    if row is None:
        return None
    return row.get(metric_key)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    verbose = "--verbose" in sys.argv or "-v" in sys.argv
    if len(args) != 1 or args[0] not in MODELS:
        print(__doc__)
        sys.exit(1)
    model = args[0]
    cfg = MODELS[model]
    root, seeds, gens = cfg["root"], cfg["seeds"], cfg["gens"]

    # values[bench][gen] = {seed: value}  — seed-keyed so the paired test aligns
    # the SAME seeds across generations even if one is missing somewhere.
    values = {b: {g: {} for g in gens} for b in cfg["benchmarks"]}
    missing = []

    for seed in seeds:
        for g in gens:
            gen_dir = f"{root}/seed{seed}/gen{g}"
            results = load_results_blob(gen_dir)
            if not results:
                missing.append(f"seed{seed} gen{g}: no results json")
                continue
            for bench, (tk, mk) in cfg["benchmarks"].items():
                v = get_metric(results, tk, mk)
                if v is None:
                    missing.append(f"seed{seed} gen{g}: {bench} missing")
                else:
                    values[bench][g][seed] = v

    def paired(bench, g):
        """Return (g0_arr, gN_arr) over seeds present in BOTH gen0 and gen g."""
        d0, dg = values[bench][0], values[bench][g]
        common = [s for s in seeds if s in d0 and s in dg]
        return (np.array([d0[s] for s in common], dtype=float),
                np.array([dg[s] for s in common], dtype=float),
                common)

    if missing:
        print("WARNING — missing data points:")
        for m in missing:
            print("   ", m)
        print()

    print(f"=== {model}  benchmark significance (paired t-test vs gen 0) ===")
    print(f"seeds={seeds}  n={len(seeds)}")
    if verbose:
        print("(verbose: per-seed values + gen-0 extraction sanity check)")
    print()

    for bench in cfg["benchmarks"]:
        d0 = values[bench][0]
        g0 = np.array([d0[s] for s in seeds if s in d0], dtype=float)

        print(f"--- {bench} ---")
        print(f"  gen0 mean={g0.mean():.4f}  (n={len(g0)})")

        # ---- gen-0 extraction sanity check against known anchor ----
        anchor = GEN0_ANCHORS.get(model, {}).get(bench)
        if anchor is not None:
            delta = g0.mean() - anchor
            flag = "OK" if abs(delta) < 0.002 else "*** MISMATCH — extraction suspect ***"
            tag = " (MMLU = example-weighted over 57 leaf subtasks)" if bench == "mmlu" else ""
            print(f"  sanity: reconstructed gen0 {g0.mean():.4f} vs logged {anchor:.4f} "
                  f"(Δ {delta:+.4f}) {flag}{tag}")

        # ---- per-seed dump ----
        if verbose:
            print("  per-seed values by generation:")
            print("    " + "gen".ljust(5) + "".join(f"s{s}".rjust(10) for s in seeds))
            for g in gens:
                dg = values[bench][g]
                row = "    " + f"{g}".ljust(5)
                for s in seeds:
                    row += (f"{dg[s]:.4f}".rjust(10) if s in dg else "--".rjust(10))
                print(row)

        # ---- per-generation paired t-test ----
        header = (f"  {'gen':>3} {'mean':>8} {'Δ vs g0':>9} {'Δ%':>7} "
                  f"{'t':>7} {'p(2-sided)':>11} {'sig?':>5} {'n':>3}")
        print(header)
        for g in gens[1:]:
            a0, ag, common = paired(bench, g)
            if len(ag) < 2:
                print(f"  {g:>3}  (insufficient paired data: n={len(ag)})")
                continue
            diff = ag - a0
            t, p = stats.ttest_rel(ag, a0)
            dpct = 100.0 * diff.mean() / a0.mean()
            sig = "***" if p < 0.05 else "ns"
            print(f"  {g:>3} {ag.mean():>8.4f} {diff.mean():>+9.4f} "
                  f"{dpct:>+6.2f}% {t:>7.3f} {p:>11.4f} {sig:>5} {len(ag):>3}")

        # headline: gen-7 endpoint
        a0, a7, _ = paired(bench, gens[-1])
        if len(a7) >= 2:
            _, p7 = stats.ttest_rel(a7, a0)
            verdict = ("SIGNIFICANT rise — adjudicate by effect size (see framing)"
                       if p7 < 0.05 else
                       "NOT significant — flat/noise; blind-spot stands without overfitting story")
            print(f"  >> gen{gens[-1]} vs gen0: p={p7:.4f}  =>  {verdict}")
        print()


if __name__ == "__main__":
    main()
